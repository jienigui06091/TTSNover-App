<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部统一 App 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="14dp"
        android:background="@color/bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TTSNover"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_tag_accent"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:text="本地离线"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_ghost"
            android:src="@drawable/ic_refresh"
            android:tint="@color/fg2"
            android:contentDescription="刷新" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_subtle" />

    <!-- 中间主内容区 (三个选项卡面板) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. 书架面板 -->
        <LinearLayout
            android:id="@+id/panelShelf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的书架"
                    android:textColor="@color/fg"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShelfInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg3"
                    android:textSize="12sp"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvShelf"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="10dp"
                android:scrollbars="none" />

            <!-- 空书架引导状态 -->
            <LinearLayout
                android:id="@+id/layoutShelfEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="60dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_book"
                    android:tint="@color/fg3" />

                <TextView
                    android:id="@+id/tvShelfEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg2"
                    android:textSize="14sp"
                    android:text="书架还是空的\n去「搜索」找一本喜爱的小说，开启听书之旅"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/btnEmptySearch"
                    style="@style/BtnPrimary"
                    android:layout_width="160dp"
                    android:layout_height="42dp"
                    android:text="立即去搜书"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 搜索面板 -->
        <LinearLayout
            android:id="@+id/panelSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:visibility="gone">

            <!-- 搜索框容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etQ"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:hint="输入书名或作者…"
                    android:singleLine="true"
                    android:inputType="text" />

                <Button
                    android:id="@+id/btnSearch"
                    style="@style/BtnPrimary"
                    android:layout_width="84dp"
                    android:layout_height="46dp"
                    android:layout_marginLeft="10dp"
                    android:text="搜索" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg3"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <ListView
                android:id="@+id/lvSearch"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="10dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- 3. 我的 / 设置面板 -->
        <ScrollView
            android:id="@+id/panelMe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- 卡片 1: 本地单机运行状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="单机离线模式"
                            android:textColor="@color/fg"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_emerald"
                            android:textColor="@color/accent2"
                            android:textSize="11sp"
                            android:text="运行正常"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fg2"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fg3"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp" />

                    <!-- 隐藏的旧功能兼容按钮 -->
                    <Button
                        android:id="@+id/btnSessions"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 卡片 2: 朗读引擎配置 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="朗读配置 (TTS)"
                    android:textColor="@color/fg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TTS 引擎供应商"
                        android:textColor="@color/fg2"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spProvider"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input" />

                    <TextView
                        android:id="@+id/tvKeyLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="API Key (保存在本地 SQLite)"
                        android:textColor="@color/fg2"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etKey"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="粘贴对应 API Key"
                        android:singleLine="true"
                        android:inputType="textPassword" />

                    <TextView
                        android:id="@+id/tvKeyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fg3"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/btnSaveKey"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:minHeight="0dp"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:text="保存 Key" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="音色 ID / 朗读语速"
                        android:textColor="@color/fg2"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/etVoice"
                            style="@style/Input"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="音色 ID（留空默认）"
                            android:singleLine="true"
                            android:inputType="text" />

                        <EditText
                            android:id="@+id/etSpeed"
                            style="@style/Input"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:hint="语速 1.18"
                            android:singleLine="true"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/btnSaveTts"
                            style="@style/BtnPrimary"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="42dp"
                            android:minHeight="0dp"
                            android:textSize="13sp"
                            android:text="保存朗读参数" />

                        <Button
                            android:id="@+id/btnTtsTest"
                            style="@style/Btn"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minHeight="0dp"
                            android:textSize="13sp"
                            android:layout_marginLeft="10dp"
                            android:text="试听效果" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 卡片 3: 书源管理 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="书源管理"
                    android:textColor="@color/fg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/btnImportSrc"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:minHeight="0dp"
                        android:textSize="13sp"
                        android:text="导入书源文件 (JSON / 网页)" />

                    <Button
                        android:id="@+id/btnSrcManage"
                        style="@style/Btn"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:minHeight="0dp"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"
                        android:text="书源管理（启停 / 批量导出）" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- 底部关于信息 -->
                <TextView
                    android:id="@+id/tvVer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fg3"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="24dp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav">

        <!-- 书架 Tab -->
        <LinearLayout
            android:id="@+id/llTabShelf"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivTabShelf"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shelf"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/tabShelf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书架"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 搜索 Tab -->
        <LinearLayout
            android:id="@+id/llTabSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivTabSearch"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:tint="@color/fg3" />

            <TextView
                android:id="@+id/tabSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textSize="11sp"
                android:textColor="@color/fg3"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- 我的 Tab -->
        <LinearLayout
            android:id="@+id/llTabMe"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/ivTabMe"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_me"
                android:tint="@color/fg3" />

            <TextView
                android:id="@+id/tabMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的"
                android:textSize="11sp"
                android:textColor="@color/fg3"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
