<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="13dp" android:paddingBottom="13dp" android:paddingLeft="4dp"
    android:paddingRight="4dp">
    <TextView android:id="@+id/tvCIdx" android:layout_width="52dp"
        android:layout_height="wrap_content" android:textColor="@color/fg2"
        android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/tvCTitle" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="@color/fg" android:textSize="14sp"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
