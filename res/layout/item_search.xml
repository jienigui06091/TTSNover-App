<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_interactive"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 模拟书封缩略图 -->
    <FrameLayout
        android:id="@+id/flSCover"
        android:layout_width="48dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_book_cover_2"
        android:padding="5dp">

        <TextView
            android:id="@+id/tvSCoverTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp" />
    </FrameLayout>

    <!-- 右侧书籍搜索匹配信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSHit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_emerald"
                android:textColor="@color/accent2"
                android:textSize="11sp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg2"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:text="+ 点击加入书架" />
    </LinearLayout>
</LinearLayout>
