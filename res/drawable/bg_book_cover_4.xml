<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#7C3AED"
                android:endColor="#4C1D95"
                android:angle="135" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#40A78BFA" />
        </shape>
    </item>
    <item android:left="6dp" android:right="0dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AFFFFFF"
                android:endColor="#00000000"
                android:angle="0" />
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
