<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
    <TextView android:id="@+id/tvBTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/fg"
        android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/tvBMeta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/fg2"
        android:textSize="12sp" android:layout_marginTop="5dp" />
</LinearLayout>
