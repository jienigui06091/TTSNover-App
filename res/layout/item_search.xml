<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_interactive"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- 模拟书封缩略图 -->
    <FrameLayout
        android:id="@+id/flSCover"
        android:layout_width="48dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_book_cover_2"
        android:padding="5dp">

        <TextView
            android:id="@+id/tvSCoverTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp" />
    </FrameLayout>

    <!-- 中间书籍信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fg"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSHit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_emerald"
                android:textColor="@color/accent2"
                android:textSize="10sp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg2"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSSourceTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:textColor="@color/fg3"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 右侧：显式手动加书架按钮 -->
    <TextView
        android:id="@+id/btnAddToShelf"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_btn_pill"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="+ 书架"
        android:focusable="false"
        android:clickable="true" />
</LinearLayout>
