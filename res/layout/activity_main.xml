<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 书架 -->
        <LinearLayout android:id="@+id/panelShelf" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" style="@style/Title" android:text="书架" />
                <TextView android:id="@+id/tvShelfInfo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/fg2"
                    android:textSize="12sp" android:layout_marginRight="10dp" />
                <Button android:id="@+id/btnRefresh" style="@style/Btn"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:text="刷新" android:textSize="13sp" android:minHeight="0dp" />
            </LinearLayout>
            <ListView android:id="@+id/lvShelf" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="10dp" android:divider="@null"
                android:dividerHeight="8dp" android:scrollbars="none" />
            <TextView android:id="@+id/tvShelfEmpty" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/fg2"
                android:text="书架是空的
去「搜索」找一本，或让网页版导入 TXT"
                android:gravity="center" android:lineSpacingExtra="4dp"
                android:visibility="gone" android:layout_marginTop="30dp" />
        </LinearLayout>

        <!-- 搜索 -->
        <LinearLayout android:id="@+id/panelSearch" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:padding="14dp" android:visibility="gone">
            <TextView style="@style/Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="搜书" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <EditText android:id="@+id/etQ" style="@style/Input"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:hint="书名或作者"
                    android:singleLine="true" android:inputType="text" />
                <Button android:id="@+id/btnSearch" style="@style/BtnPrimary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp" android:text="搜索" />
            </LinearLayout>
            <TextView android:id="@+id/tvStat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/fg2"
                android:textSize="12sp" android:layout_marginTop="8dp" />
            <ListView android:id="@+id/lvSearch" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="6dp" android:divider="@null"
                android:dividerHeight="8dp" android:scrollbars="none" />
        </LinearLayout>

        <!-- 我的 -->
        <ScrollView android:id="@+id/panelMe" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView style="@style/Title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="我的" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card"
                    android:padding="14dp" android:layout_marginTop="12dp">
                    <TextView android:id="@+id/tvAccount" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/fg"
                        android:textSize="15sp" />
                    <TextView android:id="@+id/tvServer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/fg2"
                        android:textSize="12sp" android:layout_marginTop="4dp" />
                    <Button android:id="@+id/btnSessions" style="@style/Btn"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:minHeight="0dp" android:textSize="13sp"
                        android:layout_marginTop="10dp" android:text="设备管理" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="朗读（TTS）" android:textColor="@color/fg" android:textSize="15sp"
                    android:textStyle="bold" android:layout_marginTop="18dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card"
                    android:padding="14dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="朗读引擎" android:textColor="@color/fg2" android:textSize="12sp" />
                    <Spinner android:id="@+id/spProvider"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input" />
                    <TextView android:id="@+id/tvKeyLabel" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="API Key（服务端加密保存，只回掩码）"
                        android:textColor="@color/fg2" android:textSize="12sp" />
                    <EditText android:id="@+id/etKey" style="@style/Input"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:hint="粘贴 key，留空不改"
                        android:singleLine="true" android:inputType="text" />
                    <TextView android:id="@+id/tvKeyState" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/fg2"
                        android:textSize="12sp" android:layout_marginTop="6dp" />
                    <Button android:id="@+id/btnSaveKey" style="@style/Btn"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:minHeight="0dp" android:textSize="13sp"
                        android:layout_marginTop="8dp" android:text="保存 Key" />

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="音色 ID / 语速" android:textColor="@color/fg2"
                        android:textSize="12sp" android:layout_marginTop="14dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <EditText android:id="@+id/etVoice" style="@style/Input"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:hint="音色 ID"
                            android:singleLine="true" android:inputType="text" />
                        <EditText android:id="@+id/etSpeed" style="@style/Input"
                            android:layout_width="90dp" android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp" android:hint="语速"
                            android:singleLine="true" android:inputType="numberDecimal" />
                    </LinearLayout>
                    <Button android:id="@+id/btnSaveTts" style="@style/Btn"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:minHeight="0dp" android:textSize="13sp"
                        android:layout_marginTop="8dp" android:text="保存朗读设置" />
                    <Button android:id="@+id/btnImportSrc" style="@style/Btn"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:minHeight="0dp" android:textSize="13sp"
                        android:layout_marginTop="8dp" android:text="导入书源 JSON" />
                    <Button android:id="@+id/btnTtsTest" style="@style/Btn"
                        android:layout_width="match_parent" android:layout_height="40dp"
                        android:minHeight="0dp" android:textSize="13sp"
                        android:layout_marginTop="8dp" android:text="试听一句" />
                </LinearLayout>

                <Button android:id="@+id/btnLogout" style="@style/Btn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="退出登录" />

                <TextView android:id="@+id/tvVer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="@color/fg2"
                    android:textSize="12sp" android:gravity="center"
                    android:layout_marginTop="16dp" android:layout_marginBottom="20dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:background="@color/bg2">
        <TextView android:id="@+id/tabShelf" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="书架" android:textSize="14sp"
            android:textColor="@color/accent" />
        <TextView android:id="@+id/tabSearch" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="搜索" android:textSize="14sp"
            android:textColor="@color/fg2" />
        <TextView android:id="@+id/tabMe" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="我的" android:textSize="14sp"
            android:textColor="@color/fg2" />
    </LinearLayout>
</LinearLayout>
