<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvSTitle" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/fg" android:textSize="16sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tvSHit" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/accent2"
            android:textSize="11sp" android:layout_marginLeft="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/tvSMeta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/fg2"
        android:textSize="12sp" android:layout_marginTop="5dp"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
